{
  "name": "listam-estate-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram real-estate bot and policy-aware Armenian property aggregator.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "relay": "node scripts/listam_relay.js",
    "relay:auth": "node scripts/listam_relay.js auth",
    "aggregate": "node scripts/realestate.js",
    "mcp": "node scripts/realestate-mcp.js",
    "check": "find src scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "lint:aggregator": "eslint src/aggregator scripts/realestate.js scripts/realestate-mcp.js tests/aggregator",
    "typecheck:aggregator": "tsc -p tsconfig.aggregator.json",
    "test:aggregator": "node --test tests/aggregator/*.test.js",
    "test:gmail": "node --test tests/gmail.test.js tests/mail-spool.test.js",
    "verify:aggregator": "npm run lint:aggregator && npm run typecheck:aggregator && npm run test:aggregator",
    "test:full": "node scripts/full_bot_test.js",
    "test:stress": "node scripts/stress_bot_test.js",
    "test": "npm run check && npm run verify:aggregator && npm run test:gmail && npm run test:full && npm run test:stress"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.9.3",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "playwright": "1.60.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.4",
    "typescript": "^7.0.2"
  }
}
