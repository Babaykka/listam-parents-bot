# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Optional fallback chat id. Usually leave empty: users subscribe by sending /start.
TELEGRAM_CHAT_ID=

# Optional AI filter setup. If set, users can describe filters in normal language.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_FILTERS_ENABLED=true

# Optional. Render usually provides RENDER_EXTERNAL_URL; set PUBLIC_URL manually if needed.
PUBLIC_URL=

# Optional. If empty, the app derives one locally; Render generates it in render.yaml.
TELEGRAM_WEBHOOK_SECRET=

# List.am monitor filters.
MAX_PRICE_USD=120000
LISTAM_CATEGORY_IDS=60,62
LISTAM_PAGES_PER_CATEGORY=3
LISTAM_PAGE_WAIT_SECONDS=60
LISTAM_CHALLENGE_MAX_SECONDS=45
NAVIGATION_TIMEOUT_MS=75000

# Official List.am saved-search email channel. Use a Google App Password, not
# the normal Gmail password. Keep both values only in local/Render secrets.
GMAIL_IMAP_ENABLED=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_LISTAM_SENDER=post@list.am
GMAIL_MAILBOX=INBOX
GMAIL_POLL_SECONDS=60
GMAIL_LOOKBACK_DAYS=14
GMAIL_RETRY_MAX_SECONDS=900
SCAN_ISSUE_ALERTS=true
SCAN_ISSUE_ALERT_AFTER=3
SCAN_ISSUE_ALERT_COOLDOWN_MINUTES=360
USER_SCAN_ENABLED=true
USER_SCAN_COOLDOWN_MINUTES=10
POLL_INTERVAL_MINUTES=5
BLOCKED_POLL_INTERVAL_MINUTES=15
BLOCKED_POLL_MAX_INTERVAL_MINUTES=60
TELEGRAM_SUBSCRIBER_POLL_SECONDS=30
TELEGRAM_SEND_DELAY_MS=80
TELEGRAM_RETRY_MAX_SECONDS=3
MIN_QUALITY_SCORE=0
SCAN_ON_START=true

# List.am relay: run `npm run relay` on a machine where List.am opens normally
# (e.g. a home computer). It scans List.am locally and pushes listings to the bot.
# INGEST_TOKEN must match the bot's INGEST_TOKEN on Render (auto-generated there,
# copy the value from the Render dashboard).
INGEST_TOKEN=
RELAY_TARGET_URL=https://listam-parents-bot.onrender.com
RELAY_INTERVAL_MINUTES=15
RELAY_PAGES_PER_CATEGORY=2
# How long the bot keeps using relayed listings before considering them stale.
RELAY_MAX_AGE_MINUTES=180

# First run initializes the seen database and does not spam old listings.
# Set true only if you want the first run to send current matches too.
SEND_INITIAL=false

# Set true to see the browser window. Useful if the site asks for normal verification.
LISTAM_SHOW_BROWSER=false

# Prints Telegram messages to terminal instead of sending.
DRY_RUN=false

# Standalone real-estate aggregator (separate from the Telegram bot).
AGGREGATOR_CONFIG=config/aggregator.json
AGGREGATOR_DATABASE=data/realestate.sqlite
AGGREGATOR_CACHE_DIR=data/aggregator-cache
AGGREGATOR_EXPORT_DIR=exports

# Estate official RSS: keep the complete sale-feed catalog, then apply each
# subscriber's price/location filters only when displaying or notifying.
ESTATE_COLLECT_ALL=true
ESTATE_DELAY_MS=10000
